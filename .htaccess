Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
# Internal folders: sessions (tmp), encryption key + JSON data (data), CLI/dev scripts, dependencies.
RewriteRule ^(?:config|database|docs|scripts|test_samples|data|tmp|vendor|scratch|deploy|migrations)(?:/|$) - [F,L,NC]
RewriteRule ^(?:AGENTS\.md|PROJECT_SUMMARY\.md|ROLLBACK\.md|README(?:\.md|\.txt)?|composer\.(?:json|lock)|create_.*\.php|test_.*\.php|\.env(?:\..*)?)$ - [F,L,NC]
</IfModule>

<FilesMatch "(?i)^(?:\.env|composer\.(?:json|lock)|.*\.(?:sql|log|ini))$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
